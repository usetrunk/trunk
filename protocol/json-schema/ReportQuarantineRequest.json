{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "object_type": {
      "type": "string",
      "enum": [
        "fact",
        "document"
      ]
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "object_type",
    "object_id",
    "reason"
  ],
  "additionalProperties": false
}
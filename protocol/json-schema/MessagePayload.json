{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "sync",
        "async"
      ]
    },
    "finality": {
      "type": "string",
      "enum": [
        "proposed",
        "decided",
        "fyi"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "question": {
      "type": "string"
    },
    "updates_facts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "content"
  ],
  "additionalProperties": {}
}
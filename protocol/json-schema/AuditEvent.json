{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "actor_agent": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "type": "string"
    },
    "target_type": {
      "type": "string"
    },
    "target_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "denied",
        "failure"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "credential": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "agent_secret",
            "scoped_grant",
            "delegation_claim",
            "webhook_signature",
            "system",
            "anonymous"
          ]
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "delegation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "parent_agent_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "parent_agent_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "message",
              "task",
              "fact",
              "document"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "relation": {
            "type": "string",
            "enum": [
              "origin",
              "input",
              "target",
              "derived_from"
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "relation"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "created_at": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "actor_agent",
    "action",
    "target_type",
    "target_id",
    "outcome",
    "reason_code",
    "credential",
    "delegation",
    "request_id",
    "trace_id",
    "provenance",
    "metadata",
    "created_at",
    "explanation"
  ],
  "additionalProperties": false
}
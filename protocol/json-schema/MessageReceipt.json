{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "thread_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered",
        "processed",
        "replied",
        "scheduled",
        "cancelled",
        "deleted",
        "undelivered"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "recipients": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scheduled_at": {
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "thread_id",
    "status",
    "created_at"
  ],
  "additionalProperties": false
}
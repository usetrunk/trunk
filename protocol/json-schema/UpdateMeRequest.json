{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "webhook_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "role": {
      "type": "string",
      "maxLength": 200
    },
    "projects": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "additionalProperties": false
}